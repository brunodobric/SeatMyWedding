	</dict>
	<key>Za %lld gostiju nema dovoljno mjesta. Dodaj stolove u Sali.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>There is no seat for %lld guest. Add tables in Venue.</string>
			<key>other</key>
			<string>There are no seats for %lld guests. Add tables in Venue.</string>
		</dict>
	</dict>
